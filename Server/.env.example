# Paths are examples. Create new dedicated state; never use existing saves/NAS config.
GAMESHELF_SOURCE_DIR=/path/to/frozen-game-source
GAMESHELF_STATE_DIR=/path/on/ext4/new-gameshelf-state
GAMESHELF_TLS_DIR=/path/to/tls-directory
GAMESHELF_BOOTSTRAP_PASSWORD_FILE=/path/to/private-bootstrap-password-file
GAMESHELF_BOOTSTRAP_USERNAME=owner
GAMESHELF_SMB_HOST=games.example.invalid
GAMESHELF_BIND_IP=127.0.0.1
GAMESHELF_HTTPS_PORT=8787
GAMESHELF_SMB_PORT=1445
GAMESHELF_PUBLIC_ORIGIN=https://games.example.invalid:8787

GAMESHELF_SERVER_NAME=GameShelf
# Public client invitation address; falls back to PUBLIC_ORIGIN if unset.
GAMESHELF_PUBLIC_ADDRESS=https://games.example.invalid:8787
# Optional leaf certificate DER SHA-256, not a token; leave empty for normal CA trust.
GAMESHELF_CERTIFICATE_SHA256=
